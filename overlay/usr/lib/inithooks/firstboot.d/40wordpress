#!/bin/bash -e
# Complete the WordPress installation from the instance description, so that
# the installer never appears and nothing about this machine was decided when
# the layer was built.
#
# What it needs and where each value comes from (keel/spec/constants.py of the
# keel repository is the table that maps a spec field to a variable):
#
#   secrets.app_password   -> APP_PASS        the WordPress administrator
#   app.options.admin_user -> APP_ADMIN_USER  that administrator's login
#   app.options.site_title -> APP_SITE_TITLE  the site title
#   app.email              -> APP_EMAIL       the administrator's address
#   app.domain             -> APP_DOMAIN      the recorded site URL
#   app.options.db_name    -> APP_DB_NAME     the database
#
# Runs at 40, after 35mysqlpass of the parent layer and after 15regen-sslcert,
# which replaces the certificate nginx serves on 443.
#
# The site logs in to MariaDB over the socket as the web user, with no
# password (unix_socket), and wp-cli as root logs in as root over the same
# socket; wp-config.php holds no secret and no salt. WordPress keeps its
# salts as options of its database when wp-config.php defines none, and this
# hook stores them there. On a cloud pair keel seeds that database to the
# replica and replicates it, so both nodes have one account and one set of
# salts, and a login of one node is a login of the other after a failover
# (decision of 2026-11-06). app.options.db_user is the account of lnmp's
# 35mysqlpass, not the site's.
#
# Whether anybody can answer the dialog is inithooks' rule, lib/console.sh,
# as for 35mysqlpass. A test of standard input for a terminal is not
# enough: tty1 of an LXC container is a terminal nobody is attached to. When
# nobody can answer and a password is not declared, the hook asks nothing,
# records that it is deferred and finishes. Nothing is written, the ready
# marker is not, and the site answers 503 until keel-init completes it.
#
# A replica gets wp-config.php and nothing else. The spec that declares
# database.server.role: replica, or a server that is read only, says the
# database comes from the primary with the copy that seeds it. The schema and
# the site are made here on a primary or a standalone node only: a schema made
# on a replica is a local database that keel refuses to replace without
# --destroy-local-database, and its rows are writes the primary never saw.
# The schema is made at the first boot and not in the image for the same
# reason (the layer carries the account, which has no password, and no schema).
#
# Neither password is ever an argument of another process. wp-config.php is
# written by a shell function, and the administrator's password is set through
# the environment of one wp-cli call, because an argument is readable by every
# process on the machine for as long as the command runs.
#
# Decisions live in lib/wordpress.sh; this file is the part that touches the
# system, and bin/wordpress.py is the only dialog.

INITHOOKS_DEFAULT="${INITHOOKS_DEFAULT:-/etc/default/inithooks}"
# shellcheck source=/etc/default/inithooks
source "$INITHOOKS_DEFAULT"
# shellcheck source=../lib/wordpress.sh
source "$INITHOOKS_PATH/lib/wordpress.sh"
# shellcheck source=/usr/lib/inithooks/lib/console.sh
source "$INITHOOKS_PATH/lib/console.sh"

fatal() { echo "fatal [40wordpress]: $*" >&2; exit 1; }

if [[ -e "$INITHOOKS_CONF" ]]; then
    # shellcheck source=/dev/null
    source "$INITHOOKS_CONF"
fi

admin_user=$(wordpress_admin_user "${APP_ADMIN_USER-}") \
    || fatal "'${APP_ADMIN_USER-}' is not a WordPress login this appliance will create"
admin_email=$(wordpress_admin_email "${APP_EMAIL-}") \
    || fatal "'${APP_EMAIL-}' is not an email address: declare app.email"
site_title=$(wordpress_site_title "${APP_SITE_TITLE-}") \
    || fatal "no site title: declare app.options.site_title"
site_url=$(wordpress_site_url "${APP_DOMAIN-}") \
    || fatal "'${APP_DOMAIN-}' is not a domain or a URL: declare app.domain"
# app.options.db_user is lnmp's (35mysqlpass); a value it would refuse is
# refused here too, before anything is written
wordpress_db_user "${APP_DB_USER-}" > /dev/null \
    || fatal "'${APP_DB_USER-}' is not a database account name this appliance will use"
db_name=$(wordpress_db_name "${APP_DB_NAME-}") \
    || fatal "'${APP_DB_NAME-}' is not a database name this appliance will use"
db_prefix=$(wordpress_db_prefix "${APP_DB_PREFIX-}") \
    || fatal "'${APP_DB_PREFIX-}' is not a table prefix this appliance will use"

role=$(wordpress_spec_role "$WORDPRESS_SPEC") \
    || fatal "cannot read database.server.role from $WORDPRESS_SPEC: a node that may be a replica writes nothing until it can"

# deferred WHAT: the one line of a hook that asks nothing, through the rule
# of inithooks. console_deferred also records the hook, so that the first
# login starts keel-init, which asks the values at a console. An inithooks
# without it has console_skipped, which writes the line only.
deferred() {
    if declare -F console_deferred > /dev/null; then
        console_deferred 40wordpress "$1"
    else
        console_skipped 40wordpress "$1"
    fi
}

mapfile -t missing < <(wordpress_missing_values "${APP_PASS-}" "$role")
if [[ ${#missing[@]} -gt 0 ]]; then
    if console_unattended; then
        why="no ${missing[*]} in $INITHOOKS_CONF: WordPress stays not installed"
        why+=" and the site answers 503; declare secrets.app_password"
        why+=" in the instance description, or keel-init asks it"
        deferred "$why"
        exit 0
    fi
    while IFS='=' read -r key value; do
        [[ -n "$key" ]] && declare "$key=$value"
    done < <("$INITHOOKS_PATH/bin/wordpress.py" "${missing[@]}")
    [[ -n "${APP_PASS-}" || "$role" == replica ]] || fatal "no password given"
fi

# The database. 35mysqlpass may have started it already; do not assume it,
# because a hook that assumes reports somebody else's failure as its own.
systemctl start "$WORDPRESS_DB_SERVICE.service"
wordpress_wait_ready "mysqladmin ping" "$WORDPRESS_WAIT_TRIES" \
    || fatal "$WORDPRESS_DB_SERVICE did not answer after $WORDPRESS_WAIT_TRIES tries"
read_only=$(mysql --batch --skip-column-names --execute='SELECT @@global.read_only') \
    || fatal "cannot read @@global.read_only from $WORDPRESS_DB_SERVICE"
replica=false
if wordpress_is_replica "$role" "$read_only"; then
    replica=true
fi

write_config() {
    # wp-config.php, written once. It holds no secret; it is readable by the
    # web server and by nobody else, as it was when it held a password.
    [[ ! -e "$WORDPRESS_CONFIG" ]] || return 0
    local tmp
    tmp=$(mktemp "$WORDPRESS_ROOT/.wp-config.php.XXXXXX") \
        || fatal "cannot write beside $WORDPRESS_CONFIG"
    trap 'rm -f "$tmp"' EXIT
    chmod 0600 "$tmp"
    wordpress_config_php "$db_name" "$WORDPRESS_DB_HOST" "$db_prefix" "$site_url" > "$tmp" \
        || fatal "cannot render wp-config.php"
    php -l "$tmp" > /dev/null || fatal "the wp-config.php just written is not valid PHP"
    chown root:"$WORDPRESS_WEB_USER" "$tmp"
    chmod 0640 "$tmp"
    mv "$tmp" "$WORDPRESS_CONFIG"
    trap - EXIT
    echo "wp-config.php written: database '$db_name' as '$WORDPRESS_DB_LOGIN' over" \
        "the socket of $WORDPRESS_DB_HOST, with no password and no salt"
}

# The site is open from here on. Until this file exists the route of the site
# answers 503 (60-keel-wordpress.conf), so the installer is never offered.
mark_ready() {
    : > "$WORDPRESS_READY" || fatal "cannot write $WORDPRESS_READY"
    chmod 0644 "$WORDPRESS_READY"
}

start_web() {
    # The web server serves the site from now on. It is started rather than
    # assumed, and never restarted: its site is a static file of keel-web and
    # of this layer, and wp-config.php is read by PHP-FPM at each request.
    systemctl start "$WORDPRESS_WEB_SERVICE.service" \
        || fatal "$WORDPRESS_WEB_SERVICE did not start"
}

# Each directory the manifest replicates has to exist before Syncthing
# configures its folder, or the folder stays in error (keel-wordpress#30). The
# image ships them; this makes one that a node lacks, on a replica too.
ensure_replicated_dirs() {
    local dir path
    for dir in uploads themes plugins languages; do
        path="$WORDPRESS_ROOT/wp-content/$dir"
        [[ -d "$path" ]] && continue
        mkdir -p "$path" || fatal "cannot make $path"
        chown "$WORDPRESS_WEB_USER:$WORDPRESS_WEB_USER" "$path" \
            || fatal "cannot give $path to $WORDPRESS_WEB_USER"
    done
}

if [[ "$replica" == true ]]; then
    write_config
    ensure_replicated_dirs
    start_web
    mark_ready
    echo "this node is a replica (role '${role:-none}', read_only $read_only): the" \
        "WordPress site and its database come from the primary; nothing was" \
        "written to the database"
    exit 0
fi

# The schema, made here and not in the image (see the top of this file); then
# the web user gets its socket account and the schema, and is asked, over
# the socket as itself, whether it reaches it.
mysql --batch --execute="$(wordpress_create_database_sql "$db_name")" \
    || fatal "cannot create the database '$db_name' on $WORDPRESS_DB_SERVICE"
account_sql=$(wordpress_socket_account_sql "$db_name") \
    || fatal "cannot build the statements of the socket account of $WORDPRESS_DB_LOGIN"
printf '%s\n' "$account_sql" | mysql --batch \
    || fatal "cannot give $WORDPRESS_DB_LOGIN its socket account on $WORDPRESS_DB_SERVICE"
runuser -u "$WORDPRESS_DB_LOGIN" -- mysql --protocol=socket --batch --skip-column-names \
    --execute="SELECT COUNT(*) FROM information_schema.schemata WHERE schema_name='$db_name'" \
    | grep -qx 1 \
    || fatal "$WORDPRESS_DB_LOGIN cannot reach the database '$db_name' over the socket"

write_config
ensure_replicated_dirs

wp() {
    command wp --allow-root --path="$WORDPRESS_ROOT" "$@"
}

# The installation. An already installed machine is left alone, so the hook
# can be run again after a failure without losing a site.
if wp core is-installed > /dev/null 2>&1; then
    echo "WordPress is already installed; leaving the site alone"
else
    mapfile -t install_args < <(wordpress_install_args "$site_url" "$site_title" \
        "$admin_user" "$admin_email") \
        || fatal "cannot build the arguments for the installation"
    # A throwaway password, because this one is an argument. The declared one
    # is set below, through the environment, before anything can be served.
    wp "${install_args[@]}" --admin_password="$(openssl rand -base64 30)" \
        || fatal "wp core install failed"
    echo "WordPress installed: '$site_title' at $site_url, administrator '$admin_user'"
    # Pretty permalinks. Only a new site gets them: the structure is a choice
    # of the owner afterwards. nginx answers them with try_files, so the
    # rules are not written to an .htaccess.
    wp rewrite structure "$WORDPRESS_PERMALINKS" > /dev/null \
        || fatal "cannot set the permalink structure"
fi

# The salts, as options of the database (wp-config.php defines none). They
# are made here, on a server that takes writes, and not at the first request,
# which may come to a read-only replica.
wp eval-file "$INITHOOKS_PATH/lib/wordpress-set-salts.php" \
    || fatal "cannot store the salts in the database '$db_name'"

# The declared administrator password, and then the site's own answer to
# whether that password works. Both are PHP beside this file rather than PHP
# inside it: a quoted snippet is not shell, so nothing can lint it and no
# coverage tool can say whether it ran. The passwords go through the
# environment in both calls.
WP_KEEL_USER="$admin_user" WP_KEEL_PASS="$APP_PASS" \
    wp eval-file "$INITHOOKS_PATH/lib/wordpress-set-password.php" \
    || fatal "cannot set the password of '$admin_user'"

wp option update admin_email "$admin_email" > /dev/null \
    || fatal "cannot set the administrator address"

# Assert the behaviour, not the file: the account is asked to authenticate
# with the declared password, and with a wrong one too, so a check that would
# accept anything cannot pass.
WP_KEEL_USER="$admin_user" WP_KEEL_PASS="$APP_PASS" \
    wp eval-file "$INITHOOKS_PATH/lib/wordpress-verify-login.php" \
    || fatal "'$admin_user' cannot authenticate with the declared secrets.app_password"

# wp-cli ran as root above, and WordPress made the directory of the month in
# wp-content/uploads while it installed. Root owns that directory, and the web
# user could not write a media file in it. The tree belongs to the web user.
chown -R "$WORDPRESS_WEB_USER:$WORDPRESS_WEB_USER" "$WORDPRESS_ROOT/wp-content/uploads" \
    || fatal "cannot give $WORDPRESS_ROOT/wp-content/uploads to $WORDPRESS_WEB_USER"

start_web
mark_ready

echo "WordPress administrator '$admin_user' set from APP_PASS" \
     "$(wordpress_masked "$APP_PASS"), authenticated against the site itself"
