# WordPress runs its scheduled work from cron rather than on page loads:
# wp-config.php sets DISABLE_WP_CRON. wp-cli runs the events that are due, as
# the web user, in the PHP of the command line. The job does not request
# wp-cron.php: the loopback addresses on port 80 are the health probe of
# Keel Web, which answers 404 to everything but /keel-health.
MAILTO=root
*/5 * * * * www-data /usr/local/bin/wp --path=/var/www/wordpress cron event run --due-now --quiet
