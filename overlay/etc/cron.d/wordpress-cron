# WordPress runs its scheduled work from cron rather than on page loads:
# wp-config.php sets DISABLE_WP_CRON. wp-cli runs the events that are due, as
# the web user, in the PHP of the command line. The job does not request
# wp-cron.php: the loopback addresses on port 80 are the health probe of
# Keel Web, which answers 404 to everything but /keel-health.
#
# A replica is read-only and every event would fail to record that it ran,
# so the job does nothing while the server says it is read-only. If the
# server cannot be asked, the job runs and wp-cli reports the real error.
MAILTO=root
*/5 * * * * www-data [ "$(/usr/bin/mysql --batch --skip-column-names --execute='SELECT @@global.read_only' 2>/dev/null)" != 1 ] && /usr/local/bin/wp --path=/var/www/wordpress cron event run --due-now --quiet
